# Copier ce fichier en `.env` a la racine puis ajuster les valeurs.
# Ce `.env` unique est lu par docker compose ET par l'API (@nestjs/config).

# --- Postgres (consomme par docker compose) ---
POSTGRES_USER=trekker
POSTGRES_PASSWORD=trekker
POSTGRES_DB=trekker
# Port expose sur l'hote. Decale du 5432 par defaut pour ne pas entrer en
# conflit avec un autre Postgres deja lance sur la machine.
POSTGRES_PORT=5440

# --- Application ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Doit correspondre aux variables POSTGRES_* ci-dessus.
DATABASE_URL=postgresql://trekker:trekker@localhost:5440/trekker

# Origines autorisees, separees par des virgules (front web, app mobile en dev).
CORS_ORIGINS=http://localhost:3001

# --- Rate limiting ---
# Fenetre en millisecondes et nombre de requetes autorisees par fenetre.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
