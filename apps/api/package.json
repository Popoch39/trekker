{
  "name": "api",
  "version": "0.0.1",
  "description": "API trekker",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "import:treks": "tsx src/scripts/import-treks.bin.ts",
    "seed": "tsx src/scripts/seed-treks.bin.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@repo/contracts": "workspace:*",
    "@repo/db": "workspace:*",
    "@thallesp/nestjs-better-auth": "^2.7.0",
    "better-auth": "^1.6.26",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.5.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@repo/typescript-config": "workspace:*",
    "@swc/core": "^1.13.5",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "pino-pretty": "^13.1.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^12.1.0",
    "ts-loader": "^9.5.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3",
    "unplugin-swc": "^1.5.10",
    "vitest": "^4.1.10"
  }
